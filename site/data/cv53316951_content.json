        "node_type": 1,
        "word": {
         "words": "當初小章魚入組時，前主創曾經說過“：我們把創作遊戲當作一種樂趣，投注我們的熱愛，一起愉快地做遊戲，並不是特別想要追求某個特定的目標”",
         "color": "#2F3238",
         "dark_color": "#D0D3D7",
         "style": {},
         "font_level": "regular",
         "bili_theme": "Ga9"
        }
       }
